# Verbinding met de database. Bij Supabase: Project settings > Database >
# Connection string (gebruik de pooler-URL voor serverless).
DATABASE_URL=postgres://postgres@localhost:5432/declaratietool

# Inloggen. 'supabase' in productie, 'dev' om lokaal zonder accounts te werken.
# De dev-modus weigert te starten als NODE_ENV=production.
AUTH_MODUS=dev

# Geheim voor de dagelijkse cron die abonnementsfacturen aanmaakt
# (/api/cron/facturen). Vercel zet dit zelf mee in de aanroep als het bestaat.
CRON_SECRET=

# Alleen nodig bij AUTH_MODUS=supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Alleen voor het instellen van wachtwoorden door de eigenaar. Nooit delen.
SUPABASE_SERVICE_ROLE_KEY=
